# Copy to .env.aws on EC2. Never commit .env.aws.
RDS_HOST=your-database.example.us-east-1.rds.amazonaws.com
RDS_PORT=3306
RDS_DATABASE=ctrlf
DB_USERNAME=ctrlf_app
# Single quotes preserve literal $ characters in Compose env files.
DB_PASSWORD='your-database-password'
RDS_TRUSTSTORE_PATH=/opt/ctrlf/certs/rds-truststore.p12
RDS_TRUSTSTORE_PASSWORD='your-truststore-password'
# Default: a host HTTPS reverse proxy forwards to localhost:3000.
# For an ALB, set 0.0.0.0 and allow port 3000 ONLY from the ALB security group.
AWS_BIND_ADDRESS=127.0.0.1
AWS_HTTP_PORT=3000
